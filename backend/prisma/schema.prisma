generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  OWNER
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
}

enum RoomType {
  STANDARD
  DELUXE
  FAMILY
  DORMITORY
}

model User {
  id String @id @default(cuid())

  fullName String

  email String @unique

  password String

  phone String? @unique

  profileImage String?

  coverImage String?

  address String?

  emergencyContact String?

  gender String?

  dob DateTime?

  bio String?

  preferredTravelStyle String?

  favoriteDestinations String[] @default([])

  role UserRole @default(USER)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  homestays Homestay[]

  bookings Booking[]

  reviews Review[]

  civicReviewsGiven CivicReview[] @relation("CivicReviewReviewer")
  civicReviewsReceived CivicReview[] @relation("CivicReviewTarget")

  favorites Favorite[]

  aiHistory AIPlannerHistory[]

  civicScore CivicScore?
}

model CivicScore {
  id String @id @default(cuid())

  score Int @default(100)

  totalReports Int @default(0)

  userId String @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CivicReview {
  id String @id @default(cuid())

  reviewerId String
  targetUserId String

  reviewer User @relation("CivicReviewReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  targetUser User @relation("CivicReviewTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  rating Int

  comment String

  images String[] @default([])

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([reviewerId, targetUserId])
  @@index([targetUserId])
  @@index([reviewerId])
}

model Homestay {
  id String @id @default(cuid())

  ownerId String

  owner User @relation(fields: [ownerId], references: [id])

  name String

  description String

  location String

  latitude Float

  longitude Float

  address String

  pricePerNight Float

  images String[]

  amenities String[]

  isVerified Boolean @default(false)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  rooms Room[]

  bookings Booking[]

  reviews Review[]

  favorites Favorite[]

  @@index([location])
  @@index([ownerId])
}

model Room {
  id String @id @default(cuid())

  homestayId String

  homestay Homestay @relation(fields: [homestayId], references: [id], onDelete: Cascade)

  roomType RoomType

  totalRooms Int

  availableRooms Int

  capacity Int

  price Float

  images String[] @default([])

  bookings Booking[]

  availabilityOverrides RoomAvailabilityOverride[]

  @@index([homestayId])
}

model RoomAvailabilityOverride {
  id String @id @default(cuid())

  roomId String

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  date DateTime

  availableRooms Int

  note String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([roomId, date])
  @@index([roomId])
  @@index([date])
}

model Booking {
  id String @id @default(cuid())

  userId String

  homestayId String
  roomId String

  user User @relation(fields: [userId], references: [id])

  homestay Homestay @relation(fields: [homestayId], references: [id])
  room Room @relation(fields: [roomId], references: [id])

  checkIn DateTime

  checkOut DateTime

  guests Int

  totalPrice Float

  status BookingStatus @default(PENDING)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([homestayId])
  @@index([roomId])
  @@index([status])
}

model Review {
  id String @id @default(cuid())

  rating Int

  comment String

  images String[]

  visitDate DateTime

  helpfulCount Int @default(0)

  ownerReply String?

  createdAt DateTime @default(now())

  userId String

  homestayId String

  user User @relation(fields: [userId], references: [id])

  homestay Homestay @relation(fields: [homestayId], references: [id])

  @@index([homestayId])
  @@index([userId])
}

model Favorite {
  id String @id @default(cuid())

  userId String

  homestayId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  homestay Homestay @relation(fields: [homestayId], references: [id], onDelete: Cascade)

  @@unique([userId, homestayId])
}

model AIPlannerHistory {
  id String @id @default(cuid())

  prompt String

  response String

  createdAt DateTime @default(now())

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
